# Generated by deploy/scripts/setup-env.sh from deploy/templates/mcp.env.template
# Hosted MCP server (ethora-mcp-server) - Streamable HTTP transport, PM2 process `mcp`.

ETHORA_MCP_TRANSPORT=http
# Bind all interfaces, like the backend PORT: the uptime container reaches the
# host via host.docker.internal (the docker bridge address), which a loopback-only
# bind would not answer. Do NOT open this port in the firewall; nginx fronts it.
ETHORA_MCP_HTTP_HOST=0.0.0.0
ETHORA_MCP_HTTP_PORT={{MCP_PORT}}
ETHORA_MCP_PUBLIC_URL={{MCP_PUBLIC_URL}}
ETHORA_MCP_TRUST_PROXY=true

# Loopback to the API process, bypassing nginx so the per-user X-Forwarded-For
# the MCP server sets survives to the API rate limiters.
ETHORA_API_URL=http://127.0.0.1:{{BACKEND_PORT}}/v1

# Base app slug; the server fetches the base app JWT itself via /v1/apps/get-config.
ETHORA_APP_DOMAIN_NAME={{BASE_APP_DOMAIN_NAME}}

ETHORA_MCP_ENABLE_DANGEROUS_TOOLS={{MCP_ENABLE_DANGEROUS_TOOLS}}

# OAuth 2.1 authorization server (the backend, public API base URL). Enables the
# /mcp/oauth entry point and /.well-known/oauth-protected-resource for Claude.ai
# and ChatGPT connector listings. Blank = OAuth entry point off.
ETHORA_MCP_AUTH_ISSUER={{OAUTH_ISSUER}}
# 4 hours: hosted assistants reconnect per conversation and session state is small.
ETHORA_MCP_SESSION_TTL_MS=14400000

# Hosted AI chat widget base URL (script is <base>/assistant.js) and the public
# API base browsers can reach; both feed the ethora-widget-embed-snippet tool.
# Blank widget URL = no hosted widget on this install (the tool emits a placeholder).
ETHORA_MCP_WIDGET_URL={{WIDGET_URL}}
ETHORA_MCP_PUBLIC_API_URL={{OAUTH_ISSUER}}

# OpenAI apps directory domain-verification token (services.mcp.openai_apps_challenge).
ETHORA_MCP_OPENAI_APPS_CHALLENGE={{MCP_OPENAI_APPS_CHALLENGE}}
