# Push service (ethora-backend/services/push)
NODE_ENV={{NODE_ENV}}
PUSH_PORT={{PUSH_PORT}}

MONGO_URI=mongodb://localhost:{{MONGO_PORT}}/{{MONGO_DB}}?directConnection=true
REDIS_HOST=localhost
REDIS_PORT={{REDIS_PORT}}

# Shared secret used by backend -> push service calls (X-B2B-Secret header)
B2B_PUSH_SECRET={{B2B_PUSH_SECRET}}

# Legacy offline push auth token (ejabberd mod_offline_post sends it as access_token).
# Default: reuse B2B_PUSH_SECRET.
PUSH_OFFLINE_AUTH_TOKEN={{B2B_PUSH_SECRET}}

# Where uploaded Firebase service-account JSON files are stored.
# Must be persistent across restarts.
PUSH_UPLOADS_DIR={{PUSH_UPLOADS_DIR}}

# Platform keys: the base app's uploaded FCM/APNs credentials serve every app
# of this install (an app with keys of its own sends with those); the service
# finds the base app in the database. PUSH_PLATFORM_PROJECT_ID only overrides
# it with another appId. See services/push/README.md, "Platform keys".
PUSH_PLATFORM_PROJECT_ID={{PUSH_PLATFORM_PROJECT_ID}}

# Push gateway: installs without the platform keys forward platform-build
# pushes to this URL (the central install's push service, /gateway/v1/push)
# with the Bearer token issued for this instance. Empty = no forwarding.
PUSH_GATEWAY_URL={{PUSH_GATEWAY_URL}}
PUSH_GATEWAY_TOKEN={{PUSH_GATEWAY_TOKEN}}

# Error tracker (Bugsink on the central monitoring server, Sentry protocol):
# services.monitoring.errors.push in deploy.yml. Empty = the push service and
# push-worker report nothing.
SENTRY_DSN={{ERRORS_PUSH_DSN}}
SENTRY_ENVIRONMENT={{ERRORS_ENVIRONMENT}}
SENTRY_RELEASE={{BUILD_VERSION}}
SENTRY_SEND_PII={{ERRORS_SEND_PII}}
ETHORA_BUILD_COMMIT={{BUILD_COMMIT}}

