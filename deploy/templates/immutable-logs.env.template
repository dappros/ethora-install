# Immutable audit logs -> S3 export job.
#
# Rendered by deploy/scripts/setup-env.sh ONLY when features.immutable_logs is
# true in deploy.yml. When the flag is false this file is not generated at all,
# so the consuming service has no credentials to reach S3 with.
#
# Values come from integrations.immutable_logs in deploy.yml. validate.sh
# rejects an install where the flag is on but any of these is missing (or
# INTERVAL_HOURS is not a positive integer).
#
# NOTE: the AWS_* names are deliberately prefixed with IMMUTABLE_LOGS_. The
# unprefixed AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION names are
# picked up implicitly by every AWS SDK in the process, which would silently
# repoint unrelated S3/MinIO clients at this bucket's credentials.

IMMUTABLE_LOGS_ENABLED={{IMMUTABLE_LOGS_ENABLED}}

# How often the upload job runs, in hours.
IMMUTABLE_LOGS_INTERVAL_HOURS={{IMMUTABLE_LOGS_INTERVAL_HOURS}}

# S3-compatible bucket connection.
IMMUTABLE_LOGS_AWS_ACCESS_KEY_ID={{IMMUTABLE_LOGS_AWS_ACCESS_KEY_ID}}
IMMUTABLE_LOGS_AWS_SECRET_ACCESS_KEY={{IMMUTABLE_LOGS_AWS_SECRET_ACCESS_KEY}}
IMMUTABLE_LOGS_AWS_REGION={{IMMUTABLE_LOGS_AWS_REGION}}
IMMUTABLE_LOGS_AWS_S3_BUCKET_NAME={{IMMUTABLE_LOGS_AWS_S3_BUCKET_NAME}}
