# Ethora Uptime service env
PORT={{UPTIME_PORT}}
DATABASE_URL={{UPTIME_DATABASE_URL}}
UPTIME_CONFIG=/config/uptime.yml

# Optional: XMPP synthetic heartbeat (used by check type: xmpp_muc_echo)
# Defaults are for localhost installs (uptime container reaches host-published ejabberd ports via host.docker.internal).
ETHORA_XMPP_API_URL=http://xmpp:5280/api
ETHORA_XMPP_SERVICE=ws://xmpp:5280/ws
ETHORA_XMPP_HOST={{XMPP_DOMAIN}}
ETHORA_XMPP_MUC_SERVICE=conference.{{XMPP_DOMAIN}}
ETHORA_XMPP_ADMIN=admin@{{XMPP_DOMAIN}}
ETHORA_XMPP_ADMIN_PASSWORD={{XMPP_ADMIN_PASSWORD}}
# Optional overrides (normally not needed; defaults are derived from the base app id)
# ETHORA_XMPP_HEALTH_USER1=
# ETHORA_XMPP_HEALTH_USER2=
# ETHORA_XMPP_HEALTH_ROOM=

# Optional: Synthetic journey regression test (only used if you enable a 'journey' check in uptime.yml)
ETHORA_API_BASE=UPTIME_API_BASE_PLACEHOLDER
ETHORA_BASE_DOMAIN_NAME={{BASE_APP_DOMAIN_NAME}}
ETHORA_ADMIN_EMAIL={{ADMIN_EMAIL}}
ETHORA_ADMIN_PASSWORD={{ADMIN_PASSWORD}}
# NOTE: This env is kept for backwards compatibility but is no longer used to mint
# new app names. Synthetic journeys now reuse a single stable app per mode whose
# displayName starts with `__uptime__` so the backend can suppress HubSpot/Slack
# analytics for it (see backend createAppV1.service.js -> isSyntheticTestApp).
ETHORA_APP_NAME_PREFIX=__uptime__journey
ETHORA_USERS_COUNT=3

# Optional: B2B / tenant-admin synthetic journey.
# Defaults below reuse the same app credentials that monoserver already exposes to the SDK playground/setup flow.
# Override them if you want the B2B journey to run against a different tenant/root app.
# Even though the env names say APP_ID / APP_SECRET, they should reference the tenant/root app
# that owns the child apps. The backend resolves tenant-scoped B2B signing from that root app record.
ETHORA_B2B_APP_ID={{PLAYGROUND_APP_ID}}
ETHORA_B2B_APP_SECRET={{PLAYGROUND_APP_SECRET}}


