# Ethora AI crawler service env
#
# Consumed by the `crawler` service in deploy/docker-compose.enterprise.yml via
# `env_file`. services/ai/crawler/main.py reads DAPPROS_URL with os.getenv();
# when it is unset the delivery pass builds the literal URL "None/<appId>" and
# requests.post fails with
#   Invalid URL 'None/<appId>': No scheme supplied
# so every crawled page is silently discarded. The callback is the only way
# results reach the backend - /crawl answers before a single page has been
# fetched - so an unset value means crawling produces nothing at all.
#
# Empty DAPPROS_URL below means services.crawler.enabled is false - the file is
# still rendered because compose validates env_file paths for every service
# regardless of profile.

# Callback the crawler POSTs crawled pages to, as
# {url, pages, job_id, seq, final, status, error}. A crawl is delivered as a
# sequence of these: zero or more batches with final=false as pages are found,
# then one terminal call with final=true and status "completed" or "failed".
# The crawler appends "/<appId>" itself, so this value must NOT contain an app id.
# Receiver: POST /v1/sources/site-crawl/internal-for-crawler/:appId
#
# Defaults to the host-published backend port over host.docker.internal rather
# than the public API domain: the receiving route carries no auth middleware,
# so it should not be reached over the internet. Override with
# services.crawler.callback_url in deploy.yml only if the backend is not
# reachable on the docker host gateway.
DAPPROS_URL={{CRAWLER_CALLBACK_URL}}

# Shared secret sent as the `x-secret` header on that callback. The backend
# checks it against its own CRAWLER_CALLBACK_SECRET and rejects the POST with
# 403 if it is missing or wrong, so the two must stay in step - both are
# rendered from the same value in .deploy.env.
CRAWLER_CALLBACK_SECRET={{CRAWLER_CALLBACK_SECRET}}

# How eagerly pages are handed over while a crawl runs. Whichever threshold
# trips first sends the batch, which is why there are two: a size-only rule
# leaves a slow site silent for minutes, and a time-only rule turns a fast site
# into one POST per page. The defaults below are what the crawler uses when
# these are unset; raise the size (or the seconds) if a large crawl is making
# the callback route noisy.
CRAWL_DELIVER_BATCH_SIZE=5
CRAWL_DELIVER_BATCH_SECONDS=10
