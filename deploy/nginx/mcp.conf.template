# The personal-URL entry point (/mcp/k/<api-key>) carries a credential in the
# request path, so this host logs method/status only - never the request line.
# (conf.d files are included in the http context, so log_format is valid here.)
log_format ethora_mcp_nopath '$remote_addr - [$time_local] "$request_method" $status $body_bytes_sent $request_time';

server {
    listen 80;
    server_name {{MCP_DOMAIN}};

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{MCP_DOMAIN}};

    ssl_certificate /etc/letsencrypt/live/{{MCP_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{MCP_DOMAIN}}/privkey.pem;

    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # MCP tool payloads (file uploads go through the API as base64/multipart).
    client_max_body_size 20m;

    # No request paths in the access log (see log_format above).
    access_log /var/log/nginx/ethora-mcp.access.log ethora_mcp_nopath;

    location / {
        proxy_pass http://127.0.0.1:{{MCP_PORT}};

        # Streamable HTTP: long-lived SSE responses on GET /mcp and streamed
        # POST /mcp replies. Keep-alive to upstream, no buffering, no caching,
        # and generous timeouts so idle event streams are not cut by nginx.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
