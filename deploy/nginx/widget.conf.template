server {
    listen 80;
    server_name {{WIDGET_DOMAIN}};

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{WIDGET_DOMAIN}};

    ssl_certificate /etc/letsencrypt/live/{{WIDGET_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{WIDGET_DOMAIN}}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    root {{WIDGET_BUILD_DIR}};

    location = /assistant.js {
        add_header Cache-Control "public, max-age=300" always;
        try_files /assistant.js =404;
    }

    location = /assistant{{WIDGET_SCRIPT_VERSION}}.js {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files /assistant{{WIDGET_SCRIPT_VERSION}}.js =404;
    }

    location ~ "^/assistant[0-9]{4}\.js(\.map)?$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /ethora_assistant.js {
        add_header Cache-Control "public, max-age=300" always;
        try_files /ethora_assistant.js =404;
    }

    location = /ethora_assistant.js.map {
        add_header Cache-Control "public, max-age=300" always;
        try_files /ethora_assistant.js.map =404;
    }

    location = /chat-component.css {
        add_header Cache-Control "public, max-age=300" always;
        try_files /chat-component.css =404;
    }

    # pdf.js, loaded by the widget only when a PDF is shown (kept out of
    # assistant.js, which it would otherwise double in size). ES modules need
    # a JavaScript MIME type and the stock mime.types has no entry for .mjs.
    location ^~ /pdfjs/ {
        types { text/javascript mjs; }
        add_header Cache-Control "public, max-age=86400" always;
        # The widget runs on the embedding site's origin; a module import()
        # from there is a CORS request.
        add_header Access-Control-Allow-Origin "*" always;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
