# "Try it on your site" demo links (/try/<site>/<token>) carry a token in the
# path. The access log keeps only its first 6 characters.
map $request_uri $ethora_try_logged_uri {
    "~^(/try/[^/?]+/)([A-Za-z0-9_-]{6})[A-Za-z0-9_-]*(.*)$" "$1$2...$3";
    default $request_uri;
}
log_format ethora_try '$remote_addr - $remote_user [$time_local] "$request_method $ethora_try_logged_uri $server_protocol" $status $body_bytes_sent "-" "$http_user_agent"';

server {
    listen 80;
    server_name {{WEB_DOMAIN}};

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{WEB_DOMAIN}};

    ssl_certificate /etc/letsencrypt/live/{{WEB_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{WEB_DOMAIN}}/privkey.pem;
    
    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    root {{FRONTEND_BUILD_DIR}};
    index index.html;

    # Serve static files
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The entry page, and every SPA route (try_files above lands here): never
    # cached, so a visitor does not keep an index.html that points at bundles a
    # deploy has replaced. add_header in a location drops the server-level
    # headers, hence the security headers repeated below.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # "Try it on your site" demo pages (ethora-app-reactjs pages/Try): the SPA,
    # never cached, no referrer leaves the page (its address carries a token,
    # and the first asset requests go out before the app can set a meta tag),
    # not indexed, logged without the token.
    location ^~ /try/ {
        # try.html: index.html whose CSP may frame any https site (the demo
        # frames the named website); index.html for builds without it.
        try_files /try.html /index.html =404;
        access_log /var/log/nginx/access.log ethora_try;
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Cache static assets
    # Runtime configuration (see ethora-app-reactjs/src/config/env.ts). Must
    # never be cached: it is what changes between deploys of the same bundle.
    # Exact match wins over the regex rule below.
    location = /config.js {
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # The AI widget embed bundle (ethora-app-reactjs/scripts/copy-widget.mjs).
    # Snippets hand out /widget/assistant.js. Older builds handed out
    # /widget/assistant-<hash>.js and deleted it on the next build, which broke
    # the widget on every site that had embedded it. Any such name that is gone
    # answers with the current bundle, so those embeds keep working. Short
    # cache, so a new build reaches visitors within minutes. Listed before the
    # generic static rule below: the first matching regex location wins.
    location ~ ^/widget/assistant(-[A-Za-z0-9_.-]+)?\.js$ {
        try_files $uri /widget/assistant.js =404;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}

