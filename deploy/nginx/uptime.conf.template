server {
    listen 80;
    server_name {{UPTIME_DOMAIN}};

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{UPTIME_DOMAIN}};

    ssl_certificate /etc/letsencrypt/live/{{UPTIME_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{UPTIME_DOMAIN}}/privkey.pem;

    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Monitoring UIs, reverse-proxied behind the same basic-auth. The containers
    # bind to 127.0.0.1 only (see docker-compose.monitoring.yml); nginx is the
    # only public path in, and it requires the htpasswd credentials. Grafana is
    # configured with serve_from_sub_path + root_url=.../grafana/ and Prometheus
    # with --web.route-prefix=/prometheus/, so no path rewriting is needed here.
    location /grafana/ {
        auth_basic "Ethora Monitoring — restricted";
        auth_basic_user_file /etc/nginx/ethora-uptime.htpasswd;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grafana Live (websockets)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /prometheus/ {
        auth_basic "Ethora Monitoring — restricted";
        auth_basic_user_file /etc/nginx/ethora-uptime.htpasswd;
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # Restrict the uptime pages + load-test control API to authenticated
        # operators. Credentials live in the htpasswd file generated by
        # setup-nginx.sh (user/password from deploy.yml or auto-generated into
        # .deploy.env). NOTE: Prometheus scrapes the raw host port :{{UPTIME_PORT}}
        # directly, bypassing nginx, so /metrics collection is unaffected.
        auth_basic "Ethora Uptime — restricted";
        auth_basic_user_file /etc/nginx/ethora-uptime.htpasswd;

        proxy_pass http://127.0.0.1:{{UPTIME_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
