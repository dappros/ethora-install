# Secure chat attachments — membership-gated. Every object request is proxied to
# the backend, which authorizes it (fileToken cookie for web, ?ft= for native)
# by chat membership and streams the object from the private MinIO bucket.
# Rendered only when domains.secure_files is set in deploy.yml.

# Log the path without the query string so ?ft= tokens never hit the access log.
log_format secure_files_noqs '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name {{SECURE_FILES_DOMAIN}};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{SECURE_FILES_DOMAIN}};

    ssl_certificate /etc/letsencrypt/live/{{SECURE_FILES_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{SECURE_FILES_DOMAIN}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/secure-files.access.log secure_files_noqs;
    add_header Referrer-Policy "no-referrer" always;
    client_max_body_size 1000M;

    location / {
        # /<bucket>/<key>[?ft=...] -> backend /internal/files/serve/<bucket>/<key>[?ft=...]
        rewrite ^/(.*)$ /internal/files/serve/$1 break;
        proxy_pass http://127.0.0.1:{{BACKEND_PORT}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
