server {
    listen 80;
    server_name {{API_DOMAIN}};

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{API_DOMAIN}};

    ssl_certificate /etc/letsencrypt/live/{{API_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{API_DOMAIN}}/privkey.pem;
    
    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Request body limit for API uploads such as avatars and attachments.
    client_max_body_size {{API_CLIENT_MAX_BODY_SIZE}};

    # Proxy settings
    # Push service reverse proxy (used by ejabberd mod_offline_post common_post_url)
    # Maps: https://api.domain/push/api/v2/push -> http://127.0.0.1:PUSH_PORT/api/v2/push
    location /push/ {
        proxy_pass http://127.0.0.1:{{PUSH_PORT}}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Prometheus scrapes /metrics on the backend port directly (see
    # monitoring/prometheus/prometheus.yml); keep it off the public host.
    location = /metrics {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:{{BACKEND_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

