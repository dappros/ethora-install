# Reverse proxy of the compose bundle, routed like the host installer's nginx
# vhosts (deploy/nginx/*.conf.template). This is a template: the config
# service fills in the placeholders (Caddy's own environment syntax, a dollar
# sign and a NAME in braces) and writes the result to the config volume,
# where the caddy service reads it. The site blocks in ETHORA_SITES depend on
# the routing mode (render-config.sh): five hosts, each importing one of the
# role snippets below (six with the ai module's widget host), or one origin
# importing single_origin. The upstreams (UPSTREAM_API and the like) are the
# compose services (api:8080, ...) unless the internal endpoints are
# overridden; ETHORA_EXTRA_SITES carries any site a host adds (the Cloudron
# package serves the web bundle from one).
# Comments name the placeholders without braces: Caddy substitutes its own
# environment everywhere in the file, comments included.
{
	email {$ACME_EMAIL}
	# Extra global options from .env (CADDY_GLOBAL_OPTIONS), e.g. `local_certs`
	# for a LAN test, or `acme_ca https://acme-staging-v02.api.letsencrypt.org/directory`.
	{$CADDY_GLOBAL_OPTIONS}
}

(security_headers) {
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		-Server
	}
}

# API (api.conf.template). With the push module, mobile apps reach the push
# service at api.<root>/push/ (ETHORA_PUSH_ROUTE is empty without it).
(api) {
	import security_headers
	# Prometheus metrics stay internal.
	@metrics path /metrics
	respond @metrics 404
	{$ETHORA_PUSH_ROUTE}
	reverse_proxy {$UPSTREAM_API}
}

# Web chat and admin panel (web.conf.template)
(web) {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	# Centrifugo real-time channel.
	handle /connection/websocket {
		reverse_proxy {$UPSTREAM_CENTRIFUGO}
	}
	handle {
		reverse_proxy {$UPSTREAM_FRONTEND}
	}
}

# XMPP over WebSocket and BOSH (xmpp.conf.template). Only the client
# endpoints: ejabberd trusts private-network peers for its admin API, and
# every request through this proxy arrives from one, so /api and /admin are
# never forwarded.
(xmpp) {
	import security_headers
	handle /ws* {
		reverse_proxy {$UPSTREAM_XMPP}
	}
	handle /bosh* {
		reverse_proxy {$UPSTREAM_XMPP}
	}
	handle {
		respond 404
	}
}

# File storage (files.conf.template). Host is passed through unchanged, which
# MinIO's presigned URLs depend on; Caddy sets no body size limit.
(files) {
	reverse_proxy {$UPSTREAM_MINIO}
}

# Chat attachments (secure-files.conf.template): the API serves this host
# itself, authorizing every object by chat membership (the fileToken cookie
# or ?ft=) and answering 404 for anything that is not <bucket>/<key>. The
# referrer policy keeps a tokenised URL out of other sites' logs.
(secure_files) {
	header Referrer-Policy "no-referrer"
	reverse_proxy {$UPSTREAM_API}
}

# Website chat widget (widget.conf.template), served by the ai module's
# widget service: assistant.js, the versioned copy and its assets. The pages
# that embed it are other origins, so the widget service answers CORS
# itself; nothing is added here.
(widget) {
	import security_headers
	reverse_proxy {$UPSTREAM_WIDGET}
}

# SDK playground (playground.conf.template): a Next.js app of its own.
(playground) {
	import security_headers
	reverse_proxy {$UPSTREAM_PLAYGROUND}
}

# Hosted MCP server (mcp.conf.template): Streamable HTTP at /mcp; the OAuth
# server behind it is the API host.
(mcp) {
	import security_headers
	reverse_proxy {$UPSTREAM_MCP}
}

# The uptime dashboard's site block is generated (render-config.sh): its
# basic_auth line carries the bcrypt hash the caddy service computes from
# the rendered password at start.

# Everything on one origin (PUBLIC_URL), routed by path. The web app owns
# every path the others do not: its routes are /, /login, /register and
# /app/...; the public files bucket is /files/, the widget (ai module) is
# /widget/ (ETHORA_WIDGET_ROUTE is empty without the module).
(single_origin) {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	@metrics path /metrics
	respond @metrics 404
	@api path /v1 /v1/* /v2 /v2/* /api-docs /api-docs/* /oauth /oauth/* /.well-known/*
	handle @api {
		reverse_proxy {$UPSTREAM_API}
	}
	{$ETHORA_PUSH_ROUTE}
	{$ETHORA_WIDGET_ROUTE}
	handle /ws* {
		reverse_proxy {$UPSTREAM_XMPP}
	}
	handle /bosh* {
		reverse_proxy {$UPSTREAM_XMPP}
	}
	handle /connection/websocket {
		reverse_proxy {$UPSTREAM_CENTRIFUGO}
	}
	handle /files/* {
		reverse_proxy {$UPSTREAM_MINIO}
	}
	handle {
		reverse_proxy {$UPSTREAM_FRONTEND}
	}
}

{$ETHORA_SITES}
{$ETHORA_EXTRA_SITES}
