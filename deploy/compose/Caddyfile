# Reverse proxy of the compose bundle, routed like the host installer's nginx
# vhosts (deploy/nginx/*.conf.template). This is a template: the config
# service fills in the {$NAME} placeholders (Caddy's own syntax) and writes
# the result to the config volume, where the caddy service reads it. The site
# blocks in {$ETHORA_SITES} depend on the routing mode (render-config.sh):
# four hosts, each importing one of the role snippets below, or one origin
# importing single_origin.
{
	email {$ACME_EMAIL}
	# Extra global options from .env (CADDY_GLOBAL_OPTIONS), e.g. `local_certs`
	# for a LAN test, or `acme_ca https://acme-staging-v02.api.letsencrypt.org/directory`.
	{$CADDY_GLOBAL_OPTIONS}
}

(security_headers) {
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		-Server
	}
}

# API (api.conf.template)
(api) {
	import security_headers
	# Prometheus metrics stay internal.
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:8080
}

# Web chat and admin panel (web.conf.template)
(web) {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	# Centrifugo real-time channel.
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	handle {
		reverse_proxy frontend:8080
	}
}

# XMPP over WebSocket and BOSH (xmpp.conf.template). Only the client
# endpoints: ejabberd trusts private-network peers for its admin API, and
# every request through this proxy arrives from one, so /api and /admin are
# never forwarded.
(xmpp) {
	import security_headers
	handle /ws* {
		reverse_proxy xmpp:5280
	}
	handle /bosh* {
		reverse_proxy xmpp:5280
	}
	handle {
		respond 404
	}
}

# File storage (files.conf.template). Host is passed through unchanged, which
# MinIO's presigned URLs depend on; Caddy sets no body size limit.
(files) {
	reverse_proxy minio:9000
}

# Everything on one origin (PUBLIC_URL), routed by path. The web app owns
# every path the others do not: its routes are /, /login, /register and
# /app/...; the public files bucket is /files/.
(single_origin) {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	@metrics path /metrics
	respond @metrics 404
	@api path /v1 /v1/* /v2 /v2/* /api-docs /api-docs/*
	handle @api {
		reverse_proxy api:8080
	}
	handle /ws* {
		reverse_proxy xmpp:5280
	}
	handle /bosh* {
		reverse_proxy xmpp:5280
	}
	handle /connection/websocket {
		reverse_proxy centrifugo:8000
	}
	handle /files/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy frontend:8080
	}
}

{$ETHORA_SITES}
