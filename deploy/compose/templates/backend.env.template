# IMMUTABLE AUDIT LOGS (tamper-evident log export to S3).
# Populated from integrations.immutable_logs only when features.immutable_logs
# is enabled; all values are empty otherwise, which must keep the log writer and
# the S3 uploader inert (nothing should reach out to AWS on a flag-off install).
# The AWS_* names are prefixed on purpose - unprefixed AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_REGION are auto-detected by every AWS SDK in the
# process and would silently repoint unrelated S3/MinIO clients.
IMMUTABLE_LOGS_ENABLED={{IMMUTABLE_LOGS_ENABLED}}
IMMUTABLE_LOGS_INTERVAL_HOURS={{IMMUTABLE_LOGS_INTERVAL_HOURS}}
IMMUTABLE_LOGS_AWS_ACCESS_KEY_ID={{IMMUTABLE_LOGS_AWS_ACCESS_KEY_ID}}
IMMUTABLE_LOGS_AWS_SECRET_ACCESS_KEY={{IMMUTABLE_LOGS_AWS_SECRET_ACCESS_KEY}}
IMMUTABLE_LOGS_AWS_REGION={{IMMUTABLE_LOGS_AWS_REGION}}
IMMUTABLE_LOGS_AWS_S3_BUCKET_NAME={{IMMUTABLE_LOGS_AWS_S3_BUCKET_NAME}}

# TRANSLATION SERVER LANGUAGES (deploy.yml `translate.languages`).
# What the separately-installed translation server can translate INTO, as
# BCP-47 tags. This is the ONLY language list the API serves to clients: it
# feeds both the interface picker (narrowed to locales the web bundle ships
# dictionaries for) and the chat translation picker (used whole), and it is
# what user language writes are validated against.
#
# The API does not read this env at request time - init-services.sh pushes it
# into Mongo (installSettings) on every install / update, and get-config serves
# it from there, because get-config is the unauthenticated bootstrap call and
# other services need the value as data. It is rendered here so the sync step
# has a single rendered source and so operators can see the configured value
# next to the rest of the backend config. Empty -> `translateLanguages: []`.
TRANSLATE_LANGUAGES={{TRANSLATE_LANGUAGES}}

# LICENSE (deploy.yml `license:`). See docs/LICENSING.md.
# ETHORA_LICENSE_KEY wins over a key uploaded through the admin panel. With
# neither, the backend runs a grace window from first boot, then restricts
# app/user creation. ETHORA_LICENSED_HOSTS is what the key's domain is checked
# against; it is derived from deploy.yml `domains:` and should not be edited.
ETHORA_LICENSE_KEY={{ETHORA_LICENSE_KEY}}
ETHORA_LICENSE_CALL_HOME={{ETHORA_LICENSE_CALL_HOME}}
ETHORA_LICENSE_SERVER_URL={{ETHORA_LICENSE_SERVER_URL}}
ETHORA_LICENSE_GRACE_DAYS={{ETHORA_LICENSE_GRACE_DAYS}}
ETHORA_LICENSED_HOSTS={{API_DOMAIN}},{{WEB_DOMAIN}},{{XMPP_DOMAIN}},{{FILES_DOMAIN}}

# Prometheus request metrics on GET /metrics (counts + latency histogram per
# route). Scraped by the monitoring stack over the host port; nginx keeps the
# path off the public API host.
ENABLE_METRICS=true
