# Signs JWT Refresh Tokens for users
REFRESH_SECRET={{REFRESH_SECRET}}

# WEB APP SETTINGS
# ROOT_DOMAIN will be set based on localhost mode
ROOT_DOMAIN_PLACEHOLDER
HOSTED_APPS_ROOT_DOMAIN={{HOSTED_APPS_ROOT_DOMAIN}}

# superadmin users for web app
PLATFORM_ACCOUNT_EMAIL="{{ADMIN_EMAIL}}"
PLATFORM_ACCOUNT_PASSWORD="{{ADMIN_PASSWORD}}"

USER_TOKEN_EXPIRATION_SECONDS=1

# Settings for initializing the main base App at the server
BASE_APP_DISPLAY_NAME={{BASE_APP_DISPLAY_NAME}}
BASE_APP_DOMAIN_NAME={{BASE_APP_DOMAIN_NAME}}
BASE_APP_OWNER_EMAIL={{BASE_APP_OWNER_EMAIL}}
BASE_APP_OWNER_PASSWORD={{BASE_APP_OWNER_PASSWORD}}
BASE_APP_START_BALANCE={{BASE_APP_START_BALANCE}}

# Ignore the below for now (intended for self-deploy like AWS)
# URLs will be set based on localhost mode
DEFAULT_APP_URL_PLACEHOLDER
VERIFY_EMAIL_WEB_URL_PLACEHOLDER
TEMP_PASSSORD_WEB_URL_PLACEHOLDER

# API settings
API_LOGGING=true
# Auth rate-limit kill switch for load testing. When "true", all auth rate
# limiters become no-ops. Default false (rate limiting ON) — keep false on prod.
# Driven by deploy.yml features.rate_limit_disabled; flip to true only on a
# QA/load box while running load tests, then back to false.
RATE_LIMIT_DISABLED={{RATE_LIMIT_DISABLED}}
# Per-IP auth limiter ceilings (requests/min). Empty = backend defaults
# (login 20, signup 10, password 10, refresh 60). Set from deploy.yml `rate_limits`,
# or auto-raised (login 120, signup 30) when the hosted MCP server is enabled.
RATE_LIMIT_AUTH_LOGIN_MAX={{RATE_LIMIT_AUTH_LOGIN_MAX}}
RATE_LIMIT_AUTH_SIGNUP_MAX={{RATE_LIMIT_AUTH_SIGNUP_MAX}}
RATE_LIMIT_AUTH_PASSWORD_MAX={{RATE_LIMIT_AUTH_PASSWORD_MAX}}
RATE_LIMIT_AUTH_REFRESH_MAX={{RATE_LIMIT_AUTH_REFRESH_MAX}}
# Feedback submissions per client IP. The anonymous ceiling is per hour, not per
# minute: an unauthenticated report is the one a first-time user sends once.
RATE_LIMIT_FEEDBACK_MAX={{RATE_LIMIT_FEEDBACK_MAX}}
RATE_LIMIT_FEEDBACK_ANON_MAX={{RATE_LIMIT_FEEDBACK_ANON_MAX}}

# OAuth 2.1 authorization server for MCP connector listings (Claude.ai, ChatGPT).
# Public API base URL used as the issuer, e.g. https://api.chat.example.com.
# Rendered when services.mcp.enabled is true (override: services.mcp.oauth_issuer);
# blank turns the /oauth/* and /.well-known/oauth-authorization-server routes off.
OAUTH_ISSUER={{OAUTH_ISSUER}}
# Refresh-token lifetime, in days. Default 7.
REFRESH_TOKEN_TTL_DAYS={{REFRESH_TOKEN_TTL_DAYS}}
# What to do when an already-rotated refresh token is presented again (outside the
# 30s grace window). The event is always audited; this only controls the response.
#   log_only      - default. Audit it, then hand the client the current token so it
#                   keeps working. Detects nothing, breaks nobody. Required while any
#                   client can still refresh from two places at once (e.g. browser tabs
#                   that do not share a refresh lock) — otherwise real users get
#                   logged out at random.
#   reject        - refuse the stale token; other sessions are untouched.
#   revoke_family - treat it as theft and revoke the whole rotation chain (the sessions
#                   descending from that one login; other devices are unaffected).
#                   Switch to this only once every client refreshes through a single lock.
REFRESH_REUSE_POLICY={{REFRESH_REUSE_POLICY}}
# Email TLD validation policy. Controls how strictly Joi validates the TLD
# segment of email addresses on signup, login, and batch user creation.
#   off   - default. Syntax-only check; accepts any TLD (recommended for
#           self-hosted/enterprise installs that ingest real-world user
#           lists with uncommon domains, e.g. .health, .bank, .son).
#   icann - Joi 17 default. Rejects unknown / reserved TLDs like
#           .example, .test, .invalid, .son.
#   list  - Allow only the comma-separated TLDs in EMAIL_TLD_ALLOWLIST
#           (case-insensitive; leading dot optional; supports multi-segment
#           public suffixes such as co.uk).
EMAIL_TLD_VALIDATION={{EMAIL_TLD_VALIDATION}}
EMAIL_TLD_ALLOWLIST={{EMAIL_TLD_ALLOWLIST}}
# Swagger UI (public)
# - Enabled by default. Set ENABLE_SWAGGER=false to disable.
ENABLE_SWAGGER={{ENABLE_SWAGGER}}
# Swagger UI (internal/advanced)
# - Must be explicitly enabled; should remain false for most installs.
ENABLE_SWAGGER_INTERNAL={{ENABLE_SWAGGER_INTERNAL}}
# OpenAPI/Swagger version (shown in /api-docs/swagger.json -> info.version)
# We use a date-based version by default: yy.mm.dd (UTC).
OPENAPI_INFO_VERSION={{ETHORA_BUILD_VERSION}}

# Build / version identity (for /ping and /ping/version)
ETHORA_BUILD_COMMIT={{ETHORA_BUILD_COMMIT}}
ETHORA_BUILD_TIME={{ETHORA_BUILD_TIME}}
ETHORA_BUILD_VERSION={{ETHORA_BUILD_VERSION}}

# CHAT SERVER / XMPP SETTINGS
# IMPORTANT:
# - The deploy init script creates an ejabberd admin account with localpart `admin`.
# - Using `admin@<domain>` here can cause confusion; most ejabberd tooling expects localpart only.
XMPP_ADMIN=admin
XMPP_PASS={{XMPP_ADMIN_PASSWORD}}
XMPP_HOST={{XMPP_DOMAIN}}
# Shared HMAC secret for the short-lived XMPP SASL JWT the client uses instead of
# the raw xmppPassword. ejabberd validates it via jwt_key (rendered from this same
# secret). Auto-generated + persisted by the deploy.
XMPP_JWT_SECRET={{XMPP_JWT_SECRET}}
# XMPP JWT lifetimes (jsonwebtoken duration syntax: 10m / 30m / 1h / 100d).
# User tokens are re-issued with every auth refresh, so keep them short. The
# widget visitor token stays long until the widget learns to re-provision a
# session on SASL auth failure (a short TTL strands reconnecting visitors).
XMPP_JWT_TTL={{XMPP_JWT_TTL}}
XMPP_JWT_WIDGET_TTL={{XMPP_JWT_WIDGET_TTL}}
# XMPP paths will be set based on localhost mode
XMPP_PATH_PLACEHOLDER
XMPP_SERVICE_PLACEHOLDER

# DATABASES
MONGO_URI=mongodb://localhost:{{MONGO_PORT}}/{{MONGO_DB}}?directConnection=true
# Separate Mongo connection for the chat message archive (search / unread).
# The `Message` model connects here; ejabberd's mod_track_message posts every
# message to /v1/chats/archive-message which upserts into this DB. Same Mongo
# instance, dedicated db name so archive volume doesn't mix with app data.
CHAT_DATABASE=mongodb://localhost:{{MONGO_PORT}}/chat_archive?directConnection=true
REDIS_HOST=localhost
REDIS_PORT={{REDIS_PORT}}

# Read-only access to ejabberd's mod_mam archive table in MySQL. The admin
# "AI Widget conversation" viewer queries it to render the message history
# of a widget MUC room. Without these set, the viewer surfaces
# "Message history is not available on this deployment". The credentials
# below match the same MySQL container ejabberd writes the archive to
# (deploy-mysql-1, root user, database ejabberd_db).
MAM_MYSQL_HOST=localhost
MAM_MYSQL_PORT={{MYSQL_PORT}}
MAM_MYSQL_USER=root
MAM_MYSQL_PASSWORD={{MYSQL_ROOT_PASSWORD}}
MAM_MYSQL_DATABASE=ejabberd_db

