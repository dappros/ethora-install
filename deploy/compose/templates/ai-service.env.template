PORT={{AI_SERVICE_PORT}}
AI_SERVICE_SECRET={{AI_SERVICE_SECRET}}
# ai-service-specific XMPP endpoint: prefer the local ejabberd loopback in
# production so the (potentially hundreds or thousands of) bot WebSocket
# connections don't burn an nginx worker_connection each. This bypasses
# nginx + TLS termination entirely and reaches ejabberd's plaintext HTTP/WS
# port directly. setup-env.sh expands the placeholder below differently
# from the shared placeholder used by frontend/backend templates.
AI_SERVICE_XMPP_SERVICE_PLACEHOLDER
XMPP_HOST={{XMPP_DOMAIN}}
MONGO_URL=mongodb://localhost:{{MONGO_PORT}}/aiservice?directConnection=true
# Backend's Mongo database (Phase 1 Agent / BotInstance / User collections -
# the operator-facing source of truth for bot inventory). ai-service reads
# bot state from here instead of its own snapshot in aiservice.bots.
BACKEND_MONGO_URL=mongodb://localhost:{{MONGO_PORT}}/{{MONGO_DB}}?directConnection=true
# This install's platform API, for ai-service -> backend internal callbacks
# (SOUL.MD self-updates, /invite <agentAddress>). Same host, so plain HTTP.
PLATFORM_API_URL={{PLATFORM_API_URL}}
AI_API_URL={{AI_API_URL}}
AI_API_KEY={{AI_API_KEY}}
AI_CHAT_MODEL={{AI_CHAT_MODEL}}
AI_EMBEDDING_MODEL={{AI_EMBEDDING_MODEL}}
PG_URL={{AI_PG_URL}}

# Error tracker (Bugsink on the central monitoring server, Sentry protocol):
# services.monitoring.errors.ai in deploy.yml. Empty = ai-service reports nothing.
SENTRY_DSN={{ERRORS_AI_DSN}}
SENTRY_ENVIRONMENT={{ERRORS_ENVIRONMENT}}
SENTRY_RELEASE={{BUILD_VERSION}}
SENTRY_SEND_PII={{ERRORS_SEND_PII}}
ETHORA_BUILD_COMMIT={{BUILD_COMMIT}}

# -----------------------------------------------------------------------------
# Bot lifecycle & scale (Phase 2 lazy bots). All optional - code defaults
# apply when these are unset. See services/ai/README.md for the full
# lifecycle write-up.
# -----------------------------------------------------------------------------
# Cold-start filter: at boot, only BotInstance.status='on' rows with
# lastActiveAt OR createdAt inside this window get spawned. Everyone else
# stays cold and lazy-spawns on /bot-instances/:xmppUsername/wake (or any
# other wake event - operator action, chat-list fetch hook, etc).
# AI_BOT_WARM_WINDOW_SEC=86400
#
# Idle disconnect: a warm bot whose lastActivityMs is older than this gets
# dropped from memory and disconnected by the sweeper. Set to 0 to disable
# (bots stay warm forever - the legacy "always live" behaviour).
# AI_BOT_IDLE_DISCONNECT_SEC=1800
#
# How often the idle sweeper runs (also the cadence of lastActiveAt
# persistence writes for survivors). Lower = quicker reclaim, more writes.
# AI_BOT_IDLE_SWEEP_INTERVAL_SEC=300
#
# Cold-start spawn throttle: cap on per-second XmppClient creations during
# initFromBackend. Prevents the SYN-flood-shaped burst that overwhelmed
# ejabberd's loopback listener at fleet sizes >~1000 bots.
# AI_BOT_SPAWN_RATE_PER_SEC=10
# AI_BOT_SPAWN_BATCH_SIZE=10
