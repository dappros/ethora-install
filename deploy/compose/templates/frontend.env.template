# API URLs will be set based on localhost mode
VITE_API_PLACEHOLDER
VITE_API_V2_PLACEHOLDER
VITE_ROOT_DOMAIN={{ROOT_DOMAIN}}
VITE_WEB_DOMAIN={{WEB_DOMAIN}}
VITE_HOSTED_APPS_ROOT_DOMAIN={{HOSTED_APPS_ROOT_DOMAIN}}
VITE_DOMAIN_NAME={{DOMAIN_NAME}}
# Brand name used as a fallback when no per-route / per-app title is set,
# and as the brand-suffix on tenant-level admin titles. Defaults to the
# base app's display_name from deploy.yml (e.g. "Ethora" for ethora.com,
# the enterprise customer's brand name for white-labeled installs).
VITE_PLATFORM_NAME={{BASE_APP_DISPLAY_NAME}}
VITE_SITE_IS_PRODUCTION=true
{{#if STRIPE_ENABLED}}
VITE_STRIPE_PUBLICK_KEY={{STRIPE_PUBLIC}}
{{/if}}
VITE_APP_ALLOWED_DOMAINS={{WEB_DOMAIN}},localhost
VITE_APP_UTM_KEYS=utm_source,utm_medium,utm_campaign,utm_term,utm_content
# XMPP service will be set based on localhost mode
VITE_APP_XMPP_SERVICE_PLACEHOLDER
VITE_APP_CENTRIFUGE_SERVICE_PLACEHOLDER
VITE_XMPP_SERVICE=conference.{{XMPP_DOMAIN}}
VITE_XMPP_HOST={{XMPP_DOMAIN}}
VITE_WIDGET_URL={{WIDGET_URL}}
VITE_WIDGET_VERSIONED_URL={{WIDGET_VERSIONED_URL}}
VITE_WIDGET_SCRIPT_VERSION={{WIDGET_SCRIPT_VERSION}}
VITE_QR_URL={{WIDGET_QR_URL}}
# AI feature umbrella surfaced to the admin UI. When "false", the Agents
# top-level tab and the AI Widget tab under App Settings render in a
# disabled state (visible but read-only / non-clickable) so operators on
# non-AI deployments understand what's available without being able to
# configure features their install doesn't ship.
VITE_AI_FEATURE_ENABLED={{AI_FEATURE_ENABLED}}
# Video/audio calls (LiveKit). Consumed by the chat-component videoCalls
# config switch. No effect unless the deployed chat-component build includes
# the calls feature. Driven by features.video_calls in deploy.yml.
VITE_VIDEO_CALLS_ENABLED={{VIDEO_CALLS_ENABLED}}
# End-to-end encryption (OMEMO 2). Consumed by the chat-component e2ee
# config switch. Off means no keys are generated and stanzas are built
# exactly as before; on, messages are encrypted in rooms the backend marks
# `e2ee` and every other room stays plain. Driven by features.e2ee in
# deploy.yml, and needs an ejabberd whose PEP access_model lets room
# members read each other's OMEMO nodes.
#
# Install gate only: the frontend ANDs this with the per-app `e2eeEnabled`
# it reads from GET /apps/get-config, so `true` here surfaces the setting to
# app owners rather than enabling encryption for every app.
VITE_E2EE_ENABLED={{E2EE_ENABLED}}
# LiveKit server URL for video/audio calls (integrations.livekit.url).
VITE_LIVEKIT_URL={{LIVEKIT_URL}}
VITE_SITE_KEY={{TURNSTILE_SITE_KEY}}

# Analytics and Services (set to 'true' to disable for local/enterprise setups)
VITE_DISABLE_FIREBASE={{DISABLE_FIREBASE}}
VITE_DISABLE_GA={{DISABLE_GA}}
VITE_DISABLE_CLARITY={{DISABLE_CLARITY}}

# Web push (FCM). Platform Firebase web-app config used by the chat push
# notifications service worker. Sourced from integrations.firebase.web in
# deploy.yml (the same project as base-app social login). Push is also
# domain-gated by VITE_APP_ALLOWED_DOMAINS; leave the project blank in
# deploy.yml to keep push disabled.
VITE_FIREBASE_API_KEY={{FIREBASE_WEB_API_KEY}}
VITE_FIREBASE_AUTH_DOMAIN={{FIREBASE_WEB_AUTH_DOMAIN}}
VITE_FIREBASE_PROJECT_ID={{FIREBASE_WEB_PROJECT_ID}}
VITE_FIREBASE_STORAGE_BUCKET={{FIREBASE_WEB_STORAGE_BUCKET}}
VITE_FIREBASE_MESSAGING_SENDER_ID={{FIREBASE_WEB_MESSAGING_SENDER_ID}}
VITE_FIREBASE_APP_ID={{FIREBASE_WEB_APP_ID}}
VITE_FIREBASE_MEASUREMENT_ID={{FIREBASE_WEB_MEASUREMENT_ID}}
# VAPID public key: Firebase Console > Project Settings > Cloud Messaging >
# Web Push certificates (key pair). Required for the browser to obtain an
# FCM token; without it push subscription fails.
VITE_VAPID_PUBLIC_KEY={{FIREBASE_WEB_VAPID_PUBLIC_KEY}}

# Tracking IDs (optional; leave empty for enterprise)
VITE_GA_ID={{GA_ID}}
VITE_GTM_ID={{GTM_ID}}
VITE_CLARITY_ID={{CLARITY_ID}}
VITE_POSTHOG_KEY={{POSTHOG_KEY}}
VITE_POSTHOG_HOST={{POSTHOG_HOST}}

# Build/version info (shown in the tiny footer on auth screens). Derived from `git log -1`
# on the deploy source repo at setup-env.sh time. yy.mm.dd is the latest commit date.
VITE_BUILD_VERSION={{BUILD_VERSION}}
VITE_BUILD_BRANCH={{BUILD_BRANCH}}
VITE_BUILD_COMMIT={{BUILD_COMMIT}}

# HubSpot (optional; disabled by default for enterprise)
VITE_HUBSPOT_ENABLED={{HUBSPOT_ENABLED}}
VITE_HUBSPOT_PORTAL_ID={{HUBSPOT_PORTAL_ID}}
VITE_HUBSPOT_FORM_ID_APP_CREATE={{HUBSPOT_FORM_ID_APP_CREATE}}
VITE_HUBSPOT_FORM_ID_SIGNUP={{HUBSPOT_FORM_ID_SIGNUP}}
VITE_HUBSPOT_FORM_ID_TUTORIAL={{HUBSPOT_FORM_ID_TUTORIAL}}
VITE_HUBSPOT_REGION={{HUBSPOT_REGION}}

# Hosted MCP server public endpoint (blank when services.mcp is disabled); drives the
# "AI assistants" settings page (personal connector URLs and client snippets).
VITE_MCP_PUBLIC_URL={{MCP_PUBLIC_URL}}
