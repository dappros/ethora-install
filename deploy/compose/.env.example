# Ethora Core, compose bundle: every value an operator sets.
#
# ./configure.sh writes .env from this file (derives nothing you did not ask
# for, generates every secret). To fill it in by hand instead:
#   cp .env.example .env and set ROOT_DOMAIN (or PUBLIC_URL) and ADMIN_EMAIL.
#   Secrets left empty are generated on the first start and kept in the
#   `secrets` volume; the generated admin password is printed once by
#   `docker compose logs config`.
#
# Names are the ones the host installer renders into the service env files
# (deploy/templates/*.env.template), so any other variable of those templates
# can be added at the end of this file, e.g. POSTMARK_ENABLED=true.

# ---------------------------------------------------------------- hosts --
# Root domain. The five public hosts derive from it; point all five at this
# server (plain A/AAAA records, or one wildcard *.<root>):
#   api.<root>  app.<root>  xmpp.<root>  files.<root>  secure-files.<root>
# No domain yet: <server IP with dashes>.sslip.io, e.g. 203-0-113-10.sslip.io.
ROOT_DOMAIN=
# Optional per-host overrides (default: api./app./xmpp./files.<ROOT_DOMAIN>).
API_DOMAIN=
WEB_DOMAIN=
XMPP_DOMAIN=
FILES_DOMAIN=
# Chat attachments, served from their own host and gated by chat membership
# (default secure-files.<ROOT_DOMAIN>). `off` drops the fifth host: attachments
# then go to the public files bucket.
SECURE_FILES_DOMAIN=
# One origin instead of five hosts: everything under one address, routed by
# path, e.g. https://chat.example.com (one DNS record, Let's Encrypt) or
# http://192.168.1.20:8420 on a LAN (set HTTP_PORT to that port). When set,
# ROOT_DOMAIN and the host overrides are not needed; attachments use the
# public files bucket.
PUBLIC_URL=

# ---------------------------------------------------------------- admin --
# Platform admin and owner of the base app; also the Let's Encrypt contact.
ADMIN_EMAIL=
# Initial password of that account. Used when the account is first created;
# change it later in the admin panel, not here.
ADMIN_PASSWORD=
# Product name shown in the web app.
BASE_APP_DISPLAY_NAME=Ethora

# -------------------------------------------------------------- licence --
# Empty key = Ethora Core, unregistered (register for free in the admin
# panel, License page). Licence: https://ethora.com/legal/ethora-core-license/
ETHORA_LICENSE_KEY=
ETHORA_LICENSE_CALL_HOME=true
ETHORA_LICENSE_SERVER_URL=

# -------------------------------------------------------------- secrets --
# Generated by ./configure.sh, or on the first start when left empty (kept in
# the `secrets` volume). MYSQL_ROOT_PASSWORD and MINIO_ROOT_* are written
# into the databases on the first start and must not change after it; the
# others can be rotated with `docker compose up -d --force-recreate`
# (rotating JWT_SECRET / REFRESH_SECRET signs everyone out).
JWT_SECRET=
REFRESH_SECRET=
XMPP_SECRET=
XMPP_JWT_SECRET=
# At-rest encryption (generated per install; rotating needs the re-encrypt tool):
# wallet private keys (passphrase), object fields and legacy uploads (hex key:iv).
CRYPTOPAIR_SECRET=
SECRET_FOR_DB_ENCRYPTION=
SECRET_FOR_FILES_ENCRYPTION=
XMPP_ADMIN_PASSWORD=
INTERNAL_REQUESTS_SECRET=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CENTRIFUGO_API_KEY=
CENTRIFUGO_HMAC_SECRET=
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=
# Used by the modules (generated like the others; harmless without them).
AI_SERVICE_SECRET=
DOCS_PARSE_SECRET=
AI_POSTGRES_PASSWORD=
B2B_PUSH_SECRET=
UPTIME_POSTGRES_PASSWORD=
# Basic auth of the uptime dashboard (user admin unless UPTIME_AUTH_USER says otherwise).
UPTIME_AUTH_PASSWORD=

# -------------------------------------------------------------- modules --
# Ethora Enterprise modules. Each one is a compose profile: add it to
# COMPOSE_PROFILES below (e.g. COMPOSE_PROFILES=caddy,ai) and the module's
# containers start with the stack; its images are in the private
# dappros repositories on Docker Hub, pulled with the registry token shown
# on the admin panel's License page (`docker login`), and the API serves
# the module's features with a licence key that carries them.
#   ai          AI agents: ai-service, docs-parse, the embeddable website chat
#               widget (host widget.<root>) and a Postgres with pgvector.
#   push        push notifications (FCM/APNs): push server and worker; the
#               API proxies /v1/push/*, mobile apps reach api.<root>/push/.
#   playground  SDK playground web app on playground.<root>.
#   mcp         hosted MCP server on mcp.<root> (OAuth on the API host).
#   uptime      uptime dashboard on uptime.<root> (basic auth), its Postgres
#               and synthetic journeys against this install.
# One origin (PUBLIC_URL): ai and push work; playground, mcp and uptime need
# the five-host layout.
# OpenAI-compatible provider of the ai module (chat and embeddings).
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-5.6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small
# Your own Postgres with the pgvector extension instead of the bundled one:
# postgresql://user:password@host:5432/database (the schema is created on start).
AI_PG_URL=
# Widget host (default widget.<ROOT_DOMAIN>; one origin: <PUBLIC_URL>/widget/).
WIDGET_DOMAIN=
# Version suffix of the widget's long-lived script URL (assistant<version>.js);
# set once per install (default: the year and month of the first start) and
# kept, so pages embedding that URL keep working.
WIDGET_SCRIPT_VERSION=
# push module: platform push keys come from the base app's uploaded FCM/APNs
# credentials (admin panel); PUSH_PLATFORM_PROJECT_ID names another app, and a
# push gateway forwards platform pushes for installs without keys of their own.
PUSH_PLATFORM_PROJECT_ID=
PUSH_GATEWAY_URL=
PUSH_GATEWAY_TOKEN=
# Hosts of the other modules (default playground./mcp./uptime.<ROOT_DOMAIN>).
PLAYGROUND_DOMAIN=
MCP_DOMAIN=
UPTIME_DOMAIN=
# mcp module: tools that write and delete through the hosted server.
MCP_ENABLE_DANGEROUS_TOOLS=true
# uptime module: dashboard login name.
UPTIME_AUTH_USER=admin

# --------------------------------------------------------------- images --
# The release line these tags follow is updated by `docker compose pull`.
ETHORA_API_IMAGE=docker.io/dappros/ethora-api:2610
ETHORA_FRONTEND_IMAGE=docker.io/dappros/ethora-frontend:2610
ETHORA_XMPP_IMAGE=docker.io/dappros/ethora-xmpp:2610
# Enterprise module images (private repositories; see "modules" above).
ETHORA_AI_IMAGE=docker.io/dappros/ethora-ai:2610
ETHORA_PUSH_IMAGE=docker.io/dappros/ethora-push:2610
ETHORA_PLAYGROUND_IMAGE=docker.io/dappros/ethora-playground:2610
ETHORA_MCP_IMAGE=docker.io/dappros/ethora-mcp:2610
ETHORA_UPTIME_IMAGE=docker.io/dappros/ethora-uptime:2610
# Renders the configuration in single/docker-compose.yml (the xmpp image plus
# the bundle's scripts and templates); the development form uses the xmpp
# image with this directory mounted instead.
ETHORA_COMPOSE_INIT_IMAGE=docker.io/dappros/ethora-compose-init:2610

# ---------------------------------------------------------------- proxy --
# `caddy` runs the bundled reverse proxy (ports 80 and 443, Let's Encrypt).
# Leave it out when the platform brings its own proxy (Coolify, Dokploy, ...)
# and route the five hosts yourself; see README.md. The other profiles are
# the Enterprise modules above (e.g. caddy,ai,push).
COMPOSE_PROFILES=caddy
# Let's Encrypt contact (default: ADMIN_EMAIL).
ACME_EMAIL=
# Extra Caddy global options, e.g. local_certs (self-signed, for a LAN test).
CADDY_GLOBAL_OPTIONS=
HTTP_PORT=80
HTTPS_PORT=443
