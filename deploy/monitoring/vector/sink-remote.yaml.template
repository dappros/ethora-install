#
# Vector sink of the `remote` monitoring mode: the central monitoring server,
# which stores the lines in its VictoriaLogs under this host's tenant (the
# tenant is stamped server-side from the token, whatever the host sends).
# Rendered by setup-nginx.sh into generated/monitoring/vector-sink.yaml from
# services.monitoring.remote in deploy.yml; loaded together with vector.yaml.

sinks:
  logs:
    type: elasticsearch
    inputs: [docker_labels, pm2_labels]
    endpoints:
      - "{{MONITORING_REMOTE_URL}}/ingest/logs/"
    mode: bulk
    api_version: v8
    healthcheck:
      enabled: false
    request:
      headers:
        Authorization: "Bearer {{MONITORING_REMOTE_TOKEN}}"
    query:
      _msg_field: message
      _time_field: timestamp
      _stream_fields: source,service,stream,level
    compression: gzip
    batch:
      timeout_secs: 5
    # Lines wait here while the server is unreachable (disk, so a restart keeps
    # them); once it is full the sources pause rather than drop.
    buffer:
      type: disk
      # 256 MiB plus a 32-byte header: the smallest disk buffer Vector accepts.
      max_size: 268435488
      when_full: block
